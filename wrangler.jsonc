{
  "name": "yaoyorozu-os",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/watari"]
  },
  "observability": {
    "enabled": true
  }
}
